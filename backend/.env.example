# ==========================================
# MONGO DB ATLAS CONFIGURATION
# ==========================================
# Get your MONGO_URL from MongoDB Atlas (https://cloud.mongodb.com/)
# Example format:
# MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=spikebulls
# Set to false for local MongoDB, true for MongoDB Atlas (default:
MONGO_TLS=true

# ==========================================
# CORS & SECURITY
# ==========================================
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
JWT_SECRET=your-very-strong-jwt-secret-here-change-this-in-production

# ==========================================
# APP URLs
# ==========================================
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8001

# ==========================================
# ADMIN ACCOUNT (auto-seeded on start)
# ==========================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password

# ==========================================
# STRIPE PAYMENTS (optional)
# ==========================================
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel

# ==========================================
# BINANCE PAY (optional API, not required for manual payments)
# ==========================================
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_WEBHOOK_SECRET=
BINANCE_PAY_MERCHANT_ID=
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com

# ==========================================
# EMAIL PROVIDER
# ==========================================
# Options: console (log to terminal), smtp, resend
EMAIL_PROVIDER=console
EMAIL_FROM=SpikeBulls <hello@yourdomain.com>

# If using SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# If using Resend
RESEND_API_KEY=re_...

# ==========================================
# MANUAL BINANCE/TRON PAYMENT
# ==========================================
PAYMENT_METHOD=binance
BINANCE_QR_TEXT=your-wallet-address
BINANCE_QR_IMAGE_URL=
BINANCE_PAY_ADDRESS=your-wallet-address
BINANCE_PAY_EMAIL=your-email@domain.com
BINANCE_PAYMENT_INSTRUCTIONS=Send USDT (TRC20) to the address above, then upload proof!

# ==========================================
# GOOGLE OAUTH (optional)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
